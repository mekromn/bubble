{
  "manifest_version": 2,
  "name": "Bubble local reply lifecycle",
  "version": "1.2",
  "browser_specific_settings": {"gecko": {"id": "chat-monitor@bubble.local"}},
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [
    {"matches": ["https://chatgpt.com/*"], "js": ["foreground.js"], "run_at": "document_start", "all_frames": false, "world": "MAIN"},
    {"matches": ["https://chatgpt.com/*"], "js": ["monitor.js"], "run_at": "document_idle", "all_frames": false}
  ]
}
